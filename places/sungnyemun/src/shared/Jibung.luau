--!strict
-- 지붕 곡면(기와골 포함). 단위 m, 출처 ID는 SOURCES.md. 메시는 tools/jibung_obj.luau 로 굽는다 (ADR 0002).
-- 면 하나의 곡면 = 단면 곡선(면 가운데) + 처마 쪽에서 위로 갈수록 줄어드는 앙곡·안허리(Cheoma.luau의 rise·anheori 표를 그대로 씀).
-- 위치는 e = (그 점의 바깥 거리) − (그 면 기둥열 반폭). 우진각이라 네 면이 같은 단면을 쓴다(처마 e·위 끝 e가 네 면 같음).
-- 단면: S4 017 종단면도에서 기와 단면을 잼(021은 옆면 기와가 잘리지 않아 못 씀).
--   017에 기와가 두 줄로 그려진다: 아랫줄 = 암키와 밑, 윗줄 = 수키와 위(GIWA_UPPER +20.001과 맞음), 사이 약 0.33.
--   그래서 수키와 등 선을 단면으로 적고, 암키와 골은 아래 기와골 단면(groove)으로 판다.
-- ponytail: 단면이 017에서 거의 곧아(상층 −0.463, 하층 −0.349 기울기) 처마 끝 꺾임만 점으로 둔다.

return {
	-- 기와골 단면 { 수키와 중심에서 떨어진 거리, 수키와 등선 아래로 깊이 } (반쪽, 대칭). 간격은 층마다(spacing)
	-- 수키와 높이 0.103·암키와 곡 0.08~0.09: S3 p.414 [도면 4-4].
	-- 맨 아래 0.255 = 017 두 줄 사이 0.33 − 암키와 3겹 두께 약 0.075 (S3 p.405). 처마 쪽은 층마다 depth 표로 얕게
	groove = {
		profile = { { 0, 0 }, { 0.045, 0.012 }, { 0.080, 0.050 }, { 0.100, 0.160 }, { 0.140, 0.235 }, { 0.180, 0.255 } },
	},
	edgeDrop = 0.12, -- 처마 끝 기와 마구리를 막는 띠 높이 (막새는 16번)
	-- 층마다 { e, 레벨 } 수키와 등선 (S4 017 윗줄, EL − 8.138). 첫 점 = 위 끝, 끝 점 = 처마 끝. rows = 메시 가로줄을 둘 e
	lower = {
		spacing = 0.385, -- S7 p.413 하층 연암 치목 기준 (S4 010은 하층 처마 줄이 0.36~0.37로 그려져 있으나 S7 연암 골 수 남북 75·동서 37과 맞는 쪽을 씀)
		-- 기와골 깊이 { e, 깊이 }: 처마 쪽에서 얕아진다. S4 017 하층 처마 단면: 맨 아래 암키와가 이매기 윗면에 얹혀 이매기 자리 깊이 약 0.20,
		-- 처마 끝 0.15 (수키와 등선 − 맨 위 암키와 윗면). 표 사이·밖은 interp 규칙 (위쪽은 0.255 그대로)
		depth = { { 1.5, 0.255 }, { 2.652, 0.20 }, { 3.152, 0.15 } },
		-- 위 끝 e −0.498 = 상층 기둥 바깥면(017 기와 3.35, 상층 기둥 3.109 + 0.262)에서 양성으로 마감. 처마 끝 7.0
		profile = { { -0.498, 5.597 }, { 2.652, 4.496 }, { 3.152, 4.343 } },
		rows = { -0.498, 0.5, 1.5, 2.652, 3.152 },
	},
	upper = {
		spacing = 0.36, -- S4 010 수키와 가장자리 선 간격(0.176~0.190 번갈아), S7 p.401 상층 연암 360과 같음
		-- 위 끝 e −3.109 = 용마루 중심(앞뒤 면) = 옆면 꼭짓점(±7.388). 처마 끝 6.5
		profile = { { -3.109, 12.112 }, { 2.891, 9.332 }, { 3.391, 9.132 } },
		rows = { -3.109, -1.5, 0, 1.5, 2.891, 3.391 },
	},
}
