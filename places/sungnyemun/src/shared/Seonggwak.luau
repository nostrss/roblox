--!strict
-- 숭례문 좌우 복원 성곽 치수. 단위 m, 출처 ID는 SOURCES.md (S7 = 수리보고서, 사실값만).
-- 건물 축 좌표로 짓는다: 육축 앞면(+Z) 양 끝 모서리에서 시작해 八자로 앞쪽(성 바깥)으로 뻗는다 (S7 p.480, S3 p.27).
-- 바깥면(경사 면석·여장·미석)은 광장 쪽, 회곽로·뒤채움은 성 안쪽.

return {
	angle = 47, -- 육축 동서축과 벌어진 각(°). S7 p.484·520 도면측정 45~50°, S12 OSM 성벽선 첫 구간 48°

	-- 단면 (S7 p.514 [도면 5-24], p.487)
	topWidth = 2.526, -- 윗면 = 여장 두께 0.986 + 회곽로 1.540
	batter = 1.23, -- 면석 최하부~최상부 평면거리 (퇴물림 60→30 mm, S7 p.511·521)
	baseWidth = 8.3, -- 뒤채움 최하단 단면길이 (면석 포함). 뒤채움 위는 흙·잔디로 덮인 비탈로 보인다 (S7 p.486~487)
	walkwayDrop = 0.5, -- 회곽로 바닥은 미석 상단보다 0.5 아래 (여장 내부 1.750 − 외부 1.250, S7 p.516)
	-- 미석 상단 = 육축 상부면 높이 (S7 p.521) → Yukchuk 석축 윗면(level 0)

	-- 여장 (S7 p.496 [도면 5-20], p.516)
	parapet = {
		height = 1.25, -- 미석 상단 위 외부 높이 (옥개석 포함)
		thickness = 0.985, -- 몸체 492 + 492
		gap = 0.253, -- 타구 (타 사이 틈). 1타 길이 = pitch − gap (동측 3.750, S7 p.516)
		roofThickness = 0.2, -- 옥개석 가운데 두께
		roofOverhang = 0.062, -- 옥개석이 몸체 밖으로 내민 폭 (양쪽)
		miseokThickness = 0.15, -- 미석 두께
		miseokOut = 0.15, -- 미석 바깥 내밈
		miseokIn = 0.05, -- 미석 안쪽 내밈 (기단 1.185 = 0.15 + 0.985 + 0.05)
		-- 총안: 타마다 원총안 2 + 근총안 1, 폭 0.24. 타 안 분할 178/560/240/777/240/777/240/560/178
		holeCenters = { 0.858, 1.875, 2.892 }, -- 1타 3.750 기준, 타 시작에서 총안 가운데까지 (짧은 타는 비례로 줄인다)
		holeWidth = 0.24,
		-- 근사: 총안 높이 범위(미석 상단 기준). 원총안 0.24 × 0.24, 근총안 외부 높이 0.907 (S7 p.473). 세로 위치는 도면에서 못 읽음
		holes = { { 0.55, 0.79 }, { 0.05, 0.957 }, { 0.55, 0.79 } },
		start = -1.4, -- 근사: 첫 타를 육축 모서리 뒤로 늘여 육축 여장 안쪽 면에 닿게 한다 (S7 p.199 "성곽여장 끝 ↔ 문루여장 내부면 640 mm")
	},

	-- 동측 53 m 전개 (S7 p.511 [도면 5-23]): 여장 10타 0~39.956, K 계단식 단부 8.869, L 단부 하단 수직 석축 2.570
	east = {
		ta = 10,
		pitch = 4.003, -- 1타 + 타구 (입면 구간 4.004)
		stepUp = { [9] = 0.18, [10] = 0.36 }, -- I·J 구간에서 한 단씩 올라간다 (S7 p.511 도면측정). 근사: 한 단 = 여장 아랫단 180 mm
		backWidth = 8.3 - 2.526 - 1.23, -- 회곽로 뒤 비탈 폭 (바닥 폭 − 윗면 − 퇴물림)
		ends = {
			{ length = 8.869, steps = 6, lowTop = 3.7 }, -- K: 면석을 꺾어 쌓은 계단식 단부. 근사: 6단, 끝 단 윗면이 지면 위 3.7 m
			{ length = 2.570, steps = 1, lowTop = 1.5 }, -- L: 5단 석축 수직벽. 근사: 지면 위 1.5 m
		},
		bend = 0,
	},

	-- 서측 16 m 전개 (S7 p.522 [도면 5-26]): 여장 A~C 10.717, D 1.896, E 1.321 (D·E에서 북쪽으로 조금 꺾여 단부)
	-- 타 수: 본문 4타(S7 p.525) vs 도면 여장 3개(p.522) → 길이가 맞는 도면 3타를 따른다
	west = {
		ta = 3,
		pitch = 10.717 / 3, -- 근사: A~C 길이를 3타로 나눔 (1타 3.319 + 타구)
		stepUp = {},
		backWidth = 3.0, -- 근사: 세종대로가 가까워 뒤 비탈을 줄였다 (지하철 위 기초, S7 p.519)
		ends = {
			{ length = 1.896, steps = 1, lowTop = 4.5 }, -- D: 수직 3단 계단식 단부 (S7 p.524). 근사: 단 높이
			{ length = 1.321, steps = 1, lowTop = 2.2 }, -- E
		},
		bend = 20, -- 근사: D·E 구간이 북쪽으로 꺾이는 각(°)
	},
}
